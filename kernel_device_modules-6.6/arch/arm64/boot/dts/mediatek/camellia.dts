/*
 * camellia charger settings: Xiaomi's 4.14 "mediatek,charger" node (camellian-t-oss
 * mt6833.dts). Phandle properties keep the 6.6 base values. camellia,sw-jeita-6band
 * enables Xiaomi's 6-band sw JEITA with per-band current limits (ported to 6.6).
 */
&charger {
	camellia,sw-jeita-6band;
	camellia,ignore-atm;
	/* camellia 4.14 used Xiaomi's "SwitchCharging2"; 6.6 has Basic/Pulse */
	algorithm_name = "Basic";
		/* BSP.Charge - 2020.12.02 - Eanble sw_jeita */
		enable_sw_jeita;
		/* enable_pe_plus; */
		/* enable_pe_2; */
		/* enable_pe_3; */
		/* enable_pe_4; */
		enable_type_c;
		power_path_support;
		enable_dynamic_mivr;

		/* common */
		battery_cv = <4350000>;
		/* BSP.Charge - 2021.01.11 - add ffc  parameters - start */
		enable_sw_ffc;
		ffc_cv_1 = <4440000>;
		ffc_cv_2 = <4430000>;
		ffc_cv_3 = <4420000>;
		ffc_cv_4 = <4410000>;
		chg_cycle_count_level1 = <1>;
		chg_cycle_count_level2 = <100>;
		chg_cycle_count_level3 = <200>;
		chg_cycle_count_level4 = <300>;
		/* BSP.Charge - 2021.01.11 - add ffc  parameters - end */
		max_charger_voltage = <14500000>;
		/* BSP.Charge - 2021.02.07 - lower mivr */
		min_charger_voltage = <4400000>;

		/* BSP.Charge - 2021.01.12 - add recharger  uisoc limit */
		recharger_uisoc_limit = <99>;

		/* dynamic mivr */
		min_charger_voltage_1 = <4200000>;
		min_charger_voltage_2 = <4000000>;
		max_dmivr_charger_current = <1400000>;

		/* charging current */
		usb_charger_current_suspend = <0>;
		usb_charger_current_unconfigured = <70000>;
		usb_charger_current_configured = <500000>;
		usb_charger_current = <500000>;
		ac_charger_current = <2050000>;
		ac_charger_input_current = <2050000>;
		/*BSP.Charge - 2020.11.18 - The charging current of non-standard charger is adjusted to 1A - start*/
		non_std_ac_charger_current = <1000000>;
		/*BSP.Charge - 2020.11.18 - The charging current of non-standard charger is adjusted to 1A - end*/
		charging_host_charger_current = <1500000>;
		apple_1_0a_charger_current = <650000>;
		apple_2_1a_charger_current = <800000>;
		ta_ac_charger_current = <3000000>;

		/* sw jeita */
		/* BSP.Charge - 2020.12.02 - modify sw_jeita standard - start */
		jeita_temp_above_t4_cv = <4090000>;
		jeita_temp_t3_to_t4_cv = <4440000>;
		jeita_temp_t2_to_t3_cv = <4440000>;
		jeita_temp_t1_to_t2_cv = <4440000>;
		jeita_temp_t0_to_t1_cv = <4440000>;
		jeita_temp_below_t0_cv = <4440000>;

		jeita_temp_t4_to_t5_cc = <2450000>;
		/* BSP.Charge - 2020.12.17 - modify sw_jeita standard - start */
		jeita_temp_t3_to_t4_cc = <3200000>;
		jeita_temp_t2_to_t3_cc = <3200000>;
		jeita_temp_t1_to_t2_cc = <2450000>;
		/* BSP.Charge - 2020.12.17 - modify sw_jeita standard - end */
		jeita_temp_t0_to_t1_cc = <980000>;
		jeita_temp_below_t0_cc = <490000>;

		temp_t5_thres = <58>;
		temp_t5_thres_minus_x_degree = <55>;
		temp_t4_thres = <48>;
		temp_t4_thres_minus_x_degree = <45>;
		temp_t3_thres = <15>;
		temp_t3_thres_plus_x_degree = <23>;
		temp_t2_thres = <10>;
		temp_t2_thres_plus_x_degree = <10>;
		temp_t1_thres = <5>;
		temp_t1_thres_plus_x_degree = <5>;
		temp_t0_thres = <0>;
		temp_t0_thres_plus_x_degree = <0>;
		temp_neg_10_thres = <10>;

		/* battery temperature protection */
		enable_min_charge_temp;
		min_charge_temp = <10>;
		min_charge_temp_plus_x_degree = <0>;
		max_charge_temp = <58>;
		max_charge_temp_minus_x_degree = <56>;
		/* BSP.Charge - 2020.12.02 - modify sw_jeita standard - end */
		/* PE */
		ta_12v_support;
		ta_9v_support;
		pe_ichg_level_threshold = <1000000>; /* uA */
		ta_ac_12v_input_current = <3200000>;
		ta_ac_9v_input_current = <3200000>;
		ta_ac_7v_input_current = <3200000>;

		/* PE 2.0 */
		pe20_ichg_level_threshold = <1000000>; /* uA */
		ta_start_battery_soc = <0>;
		ta_stop_battery_soc = <85>;

		/* PE 4.0 */
		high_temp_to_leave_pe40 = <46>;
		high_temp_to_enter_pe40 = <39>;
		low_temp_to_leave_pe40 = <10>;
		low_temp_to_enter_pe40 = <16>;

		/* PE 4.0 single charger*/
		pe40_single_charger_input_current = <3000000>;
		pe40_single_charger_current = <3000000>;

		/* PE 4.0 dual charger*/
		pe40_dual_charger_input_current = <3000000>;
		pe40_dual_charger_chg1_current = <2000000>;
		pe40_dual_charger_chg2_current = <2000000>;
		pe40_stop_battery_soc = <80>;

		/* PE 4.0 cable impedance (mohm) */
		pe40_r_cable_1a_lower = <559>;
		pe40_r_cable_2a_lower = <420>;
		pe40_r_cable_3a_lower = <279>;

		/* dual charger */
		chg1_ta_ac_charger_current = <1500000>;
		chg2_ta_ac_charger_current = <1500000>;
		slave_mivr_diff = <100000>;
		dual_polling_ieoc = <750000>;

		/* cable measurement impedance */
		cable_imp_threshold = <699>;
		vbat_cable_imp_threshold = <3900000>; /* uV */

		/* bif */
		bif_threshold1 = <4250000>;
		bif_threshold2 = <4300000>;
		bif_cv_under_threshold2 = <4450000>;

		/* PD */
		pd_vbus_low_bound = <5000000>;
		pd_vbus_upper_bound = <5000000>;
		pd_ichg_level_threshold = <1000000>; /* uA */
		pd_stop_battery_soc = <80>;

		ibus_err = <14>;
		vsys_watt = <5000000>;
};

/*
 * camellia backlight: the 6.6 base mtk_leds node has no compatible (Camellia sets
 * it per board), so leds-mtk-disp would never bind. camellia 4.14 used
 * mediatek,disp-leds with an 11-bit backlight (BSP.LCM 2020.12.16: 2047).
 * leds-mtk-disp also drives the KTD3136/LM3697 IC LK reports in ":bklic=".
 */
/*
 * Charger limits as in camellia's stock dt. LK reads lk_charger for off-mode
 * charging: the mt6833 default lets it draw 3.2 A from a DCP (stock 2.05 A).
 * max_charger_voltage (6.5 V) and non_std (0.5 A) stay below stock's 14.5 V/1 A.
 */
&lk_charger {
	ac_charger_input_current = <2050000>;
};

&mt6360_chg {
	ieoc = <200000>;	/* stock end-of-charge current (6.6 default 150 mA) */
};

/*
 * Microtrust TEE (Beanpod keymaster, teei_daemon). The 6.6 isee driver only
 * starts uTos when the board marks it real ("MICROTRUST device is NOT enable"
 * otherwise; Camellia boards set the trustonic equivalent per project).
 */
&utos {
	microtrust,real-drv = <1>;
};

/* TEE shared memory, as in camellia's stock dt (soter, isee TEEI_DTS_RESERVED_MEM) */
&reserved_memory {
	soter-shared-mem {
		compatible = "microtrust,shared_mem";
		no-map;
		size = <0 0x800000>;
		alignment = <0 0x1000000>;
		alloc-ranges = <0 0x40000000 0 0x50000000>;
	};
};

/*
 * A new root node rather than &mtk_leds: the stock sepolicy labels the
 * backlight sysfs_leds by path, /sys/devices/platform/disp_leds/leds/...
 * (4.14's node name). Under mtk_leds it stays plain sysfs, and the
 * framework, lights HAL and displayfeature cannot write it.
 */
&{/} {
	disp_leds {
		compatible = "mediatek,disp-leds";

		backlight {
			label = "lcd-backlight";
			max-brightness = <2047>;
			max-hw-brightness = <2047>;
			default-state = "on";
		};
	};
};

/* camellia 4.14 base dtb: platform device for the xiaomi-touch mode/feature
 * glue (touchfeature HAL); FT8722/NT36672C register into it at probe */
&{/} {
	xiaomi_touch {
		compatible = "xiaomi-touch";
		status = "okay";
		touch,name = "xiaomi-touch";
	};

	/* 4.14 "ac"/"usb" supplies at /sys/devices/platform/mt_charger, the path
	 * the stock vendor sepolicy labels sysfs_batteryinfo (camellia_mt_charger) */
	mt_charger {
		compatible = "mediatek,mt-charger";
	};
};

/*
 * camellia: video codec nodes in the layout of the 4.14 driver the stock
 * vpud/codec2 need (camellia_vcodec): stock reg order and VCU GCE threads,
 * "mediatek,larb" and the 4.14 clock names, on the 6.6 clock/IOMMU providers.
 */
&vcu {
	reg = <0 0x16000000 0 0x40000>,	/* VDEC_BASE */
	      <0 0x17020000 0 0x10000>,	/* VENC_BASE */
	      <0 0x17820000 0 0x10000>;	/* VENC_C1_BASE (stock) */
	mediatek,dec_gce_th_num = <1>;
	mediatek,enc_gce_th_num = <1>;
	/* dec thread, enc thread, secure enc thread (stock order) */
	mboxes = <&gce 7 0 1>, <&gce 12 0 1>, <&gce_sec 12 0 1>;
};

&{/soc/vdec@16000000} {
	reg = <0 0x1602f000 0 0x1000>,	/* VDEC_SYS */
	      <0 0x16020000 0 0x400>,	/* VDEC_VLD */
	      <0 0x16021000 0 0x1000>,	/* VDEC_MC */
	      <0 0x16023000 0 0x1000>,	/* VDEC_MV */
	      <0 0x16025000 0 0x1000>;	/* VDEC_MISC */
	/delete-property/ reg-names;
	mediatek,larb = <&smi_larb4>;
	clock-names = "MT_CG_VDEC";
};

&{/soc/venc@17000000} {
	mediatek,larb = <&smi_larb7>;
	clock-names = "MT_CG_VENC";
};

/* ST21NFC on i2c7 @0x08: IRQ GPIO5, reset GPIO48 (4.14 cust.dtsi + mt6833.dts nfc node) */
&i2c7 {
	st21nfc@8 {
		compatible = "st,st21nfc";
		reg = <0x08>;
		interrupt-parent = <&pio>;
		interrupts = <5 IRQ_TYPE_LEVEL_HIGH>;
		irq-gpios = <&pio 5 0>;
		reset-gpios = <&pio 48 0>;
		status = "okay";
	};
};

/* MediaTek reference board's vcama GPIO regulator: on camellia GPIO92 is unused
 * (cam1 vcama is GPIO7), stock leaves it an input */
&cam1_vcama {
	status = "disabled";
};

/* No MT6382 display bridge on camellia: nothing binds this mailbox, and as an
 * fw_devlink supplier it held off mediatek-drm until the deferred probe timeout
 * (~40s), after the composer HAL had already started and crashed.
 */
&gce_mbox_bdg {
	status = "disabled";
};

/* camellia boots from UFS, there is no eMMC: the reference-board mmc0 only
 * probed and reset an empty bus. Park its pins pulled down, as stock does.
 */
&mmc0 {
	status = "disabled";
};

&pio {
	pinctrl-names = "default";
	pinctrl-0 = <&camellia_unused_pins>;

	camellia_unused_pins: camellia_unused_pins {
		pins_msdc0 {
			pinmux = <PINMUX_GPIO65__FUNC_GPIO65>,
				 <PINMUX_GPIO66__FUNC_GPIO66>,
				 <PINMUX_GPIO67__FUNC_GPIO67>,
				 <PINMUX_GPIO68__FUNC_GPIO68>,
				 <PINMUX_GPIO69__FUNC_GPIO69>,
				 <PINMUX_GPIO70__FUNC_GPIO70>,
				 <PINMUX_GPIO71__FUNC_GPIO71>,
				 <PINMUX_GPIO72__FUNC_GPIO72>,
				 <PINMUX_GPIO73__FUNC_GPIO73>,
				 <PINMUX_GPIO74__FUNC_GPIO74>,
				 <PINMUX_GPIO75__FUNC_GPIO75>,
				 <PINMUX_GPIO76__FUNC_GPIO76>;
			input-enable;
			bias-pull-down;
		};
	};
};

/* microSD: idle drive strength as on 4.14 (the UHS state already uses 3) */
&mmc1_pins_default {
	pins_cmd_dat {
		drive-strength = <3>;
	};
	pins_clk {
		drive-strength = <3>;
	};
};
