&spi0 {
	status = "ok";
	irled@0 {
		compatible = "ir-spi";
		reg = <0x0>;
		//vdd-supply = <&pm8953_l8>; //vdd
		status = "ok";
		spi-max-frequency = <19200000>;
	};
};

&pio {
	/* IRTX GPIO Settings -Start */
	/* default: GPIO0, output, high */
	irtx_gpio_led_default:irtx_gpio_led_def@gpio25 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO25__FUNC_GPIO25>;
			slew-rate = <1>;
			bias-disable;
			output-low;
			input-schmitt-enable = <0>;
		};
	};

	irtx_gpio_led_set:irtx_gpio_led_set@gpio25 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO25__FUNC_PWM_1>;
			slew-rate = <1>;
			output-high;
		};
	};
}; /* IRTX GPIO Settings -End */

&irtx_pwm {
	pinctrl-names = "irtx_gpio_led_default", "irtx_gpio_led_set";
	pinctrl-0 = <&irtx_gpio_led_default>;
	pinctrl-1 = <&irtx_gpio_led_set>;
	status = "okay";
};

&gps {
	pinctrl-names = "default",
		"gps_l1_lna_disable",
		"gps_l1_lna_dsp_ctrl",
		"gps_l1_lna_enable",
		"gps_l5_lna_disable",
		"gps_l5_lna_dsp_ctrl",
		"gps_l5_lna_enable";
	pinctrl-0 = <&gps_pins_default>;
	pinctrl-1 = <&gps_l1_lna_pins_ol>;
	pinctrl-2 = <&gps_l1_lna_pins_dsp_ctrl>;
	pinctrl-3 = <&gps_l1_lna_pins_oh>;
	pinctrl-4 = <&gps_l5_lna_pins_ol>;
	pinctrl-5 = <&gps_l5_lna_pins_dsp_ctrl>;
	pinctrl-6 = <&gps_l5_lna_pins_oh>;
	status = "okay";
};
/* GPS GPIO standardization end */

/* BSP.Audio - 2020.11.2 - modify to bring up PA */
&i2c6 {
	aw87559_pa_58@58 {
		compatible = "awinic,aw87559_pa";
		reg = <0x58>;
		reset-gpio = <&pio 139 0>;
		monitor-flag = <1>;
		pa-channel = < 0 >;
		actflag-gain-array = < 0x00 0x08 0x08 0x08 0x00 >;
		gain-reg-addr = <0x06>;
		monitor-timer-val = <3000>;
		monitor-timer-count-max = <5>;
		status = "okay";
	};
};
/* end modify*/
/* BSP.LCM - 2020.11.14 - modify to set brightness */
&i2c6 {
	lm3697@36 {
		compatible = "ti,lm3697";
		reg = <0x36>;
		status = "okay";
		enable-gpios = <&pio 160 0>;
		backlight {
			compatible = "ti,lm3697-backlight";
			lcd {
				led-sources = <0 1 2>;
				ramp-up-msec = <200>;
				ramp-down-msec = <200>;
				pwm-period = <0>;
				default-brightness-level = <255>;
			};
		};
		fault-monitor {
			compatible = "ti,lm3697-fault-monitor";
		};
	};

	ktd@37 {
		compatible = "ktd,ktd3137";
		reg = <0x37>;
		status = "okay";
		/*ktd,pwm-mode; */
		ktd,using-lsb = <1>;
		ktd,pwm-frequency = <100>;
		ktd,bl-fscal-led = <0xA9>;/*default 21.8mA*/
		ktd,turn-on-ramp = <0>;
		ktd,turn-off-ramp = <0>;
		ktd,pwm-trans-dim = <0>;
		ktd,i2c-trans-dim = <0>;
		ktd,bl-channel = <2>;
		ktd,ovp-level = <32>; /*default 32v*/
		ktd,switching-frequency = <1000>; /*default 1000kHz*/
		ktd,inductor-current = <2600>; //default 2600mA
		//ktd,linear_ramp = <1>; /*default is exponential*/
		//ktd,linear_backlight = <1>; /*default is exponential*/
		};
};
/* end modify*/

/* camellia: the FS1815 below sits at 0x34; MTK's generic smart-PA node too */
&speaker_amp {
	status = "disabled";
};

/* BSP.Audio - 2020.11.11 - modify to bring up second PA */
&i2c6 {
	fs16xx@34 {
		compatible = "foursemi,fs16xx";
		reg = <0x34>;
		fsm,rst-gpio = <&pio 139 1>;
		status = "okay";
	};
};
/* end modify*/
#include "mediatek/cust_camellia_camera.dtsi"
#include <camellia/cust.dtsi>
